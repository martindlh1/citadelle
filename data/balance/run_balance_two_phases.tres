[gd_resource type="Resource" script_class="RunBalance" format=3]

[ext_resource type="Script" path="res://src/schema/run_balance.gd" id="1_run_balance"]
[ext_resource type="Script" path="res://src/schema/phase_def.gd" id="2_phase_def"]
[ext_resource type="Script" path="res://src/schema/wave_slot.gd" id="3_wave_slot"]
[ext_resource type="Resource" path="res://data/waves/skirmish.tres" id="4_skirmish"]
[ext_resource type="Resource" path="res://data/waves/raid.tres" id="5_raid"]
[ext_resource type="Resource" path="res://data/waves/siege.tres" id="6_siege"]

[sub_resource type="Resource" id="Resource_phase_morning"]
script = ExtResource("2_phase_def")
id = &"morning"
label = "Matin"
color = Color(0.45, 0.66, 0.88, 1)
allows = Array[StringName]([&"play", &"assign"])
resolves = true

[sub_resource type="Resource" id="Resource_phase_afternoon"]
script = ExtResource("2_phase_def")
id = &"afternoon"
label = "Après-midi"
color = Color(0.93, 0.66, 0.31, 1)
allows = Array[StringName]([&"play", &"assign"])
resolves = true

[sub_resource type="Resource" id="Resource_wave_5"]
script = ExtResource("3_wave_slot")
day = 5
wave = ExtResource("4_skirmish")

[sub_resource type="Resource" id="Resource_wave_10"]
script = ExtResource("3_wave_slot")
day = 10
wave = ExtResource("5_raid")

[sub_resource type="Resource" id="Resource_wave_15"]
script = ExtResource("3_wave_slot")
day = 15
wave = ExtResource("6_siege")

[resource]
script = ExtResource("1_run_balance")
phases = Array[PhaseDef]([SubResource("Resource_phase_morning"), SubResource("Resource_phase_afternoon")])
days = 15
starting_building = &"heart"
waves = Array[WaveSlot]([SubResource("Resource_wave_5"), SubResource("Resource_wave_10"), SubResource("Resource_wave_15")])
score_per_resource = 1
score_per_building = 10
score_per_worker = 20
score_per_worker_level = 5
